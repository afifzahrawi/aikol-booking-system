DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
DJANGO_ALLOWED_HOSTS=booking-aikol.example.org
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
R2_BUCKET_NAME=aikol-booking-media
R2_BACKUP_BUCKET_NAME=aikol-booking-backups
R2_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
R2_MEDIA_SOFT_LIMIT_BYTES=2147483648
R2_BACKUP_SOFT_LIMIT_BYTES=7516192768
R2_BACKUP_MAX_OBJECTS=14
